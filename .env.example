# All secrets stay on the server. Never paste secret keys into index.html.
APP_MODE=preview
PUBLIC_ORIGIN=https://aiberlin.dtcdev.click
CONTACT_EMAIL=alexey@datatalks.club
# One-time EUR 59 total; fixed quantity 1; no adjustable quantity, discounts,
# recurring charges, optional products or taxes added on top of EUR 59.
STRIPE_PAYMENT_LINK=https://buy.stripe.com/YOUR-LINK
STRIPE_PAYMENT_LINK_ID=plink_YOUR-LINK-ID
STRIPE_WEBHOOK_SECRET=whsec_YOUR-ENDPOINT-SECRET
# false for test checkout, true only after test-mode verification:
STRIPE_LIVEMODE=false
LEGAL_READY=true
# Local SQLite. In AWS, DynamoDB is used instead.
# DATABASE_PATH=/absolute/private/path/applications.sqlite3
# DYNAMODB_TABLE=solo-ai-berlin
